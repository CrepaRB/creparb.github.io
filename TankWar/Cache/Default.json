    "bgHtml": "<!DOCTYPE html>\r\n<html lang=\"zh-CN\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>稳定背景 · 岑鸽</title>\r\n    <style>\r\n        /* ===== CSS 变量（与原页面一致） ===== */\r\n        :root {\r\n            /* 浅色主题 */\r\n            --light-color-bg-default: #EEF;\r\n            --light-color-text-primary: #3B526B;\r\n            --light-color-text-secondary: #6B869E;\r\n            --light-color-bg-topbar: #E8F0FE;\r\n            --light-color-bg-topbar-t: #E8F0FE00;\r\n            --light-pause-transition-color: #FFF;\r\n            --light-pause-background-color: #EEF;\r\n\r\n            /* 深色主题 */\r\n            --dark-color-bg-default: #000005;\r\n            --dark-color-text-primary: #95c0e5;\r\n            --dark-color-text-secondary: #7896b3;\r\n            --dark-color-bg-topbar: #1a1a1a;\r\n            --dark-color-bg-topbar-t: #1a1a1a00;\r\n            --dark-pause-transition-color: #000;\r\n            --dark-pause-background-color: #000005;\r\n\r\n            /* 装饰颜色 */\r\n            --color-accent: #006ED356;\r\n            --color-border: #004A9437;\r\n            --ring-stroke-color: #006ED356;\r\n            --ring-fill-color: #0084ff0A;\r\n            --ring-blur: 4px;\r\n            --ring-stroke-width: 3px;\r\n\r\n            /* 线框深度参数 */\r\n            --wire-pc-depth-zero-scale: 0.5;\r\n            --wire-pc-depth-zero-color: #006ED356;\r\n            --wire-pc-depth-zero-line-width: 10px;\r\n            --max-depth: 20;\r\n\r\n            /* 尺寸 */\r\n            --decoration-size: clamp(180px, 25vw, 360px);\r\n\r\n            /* 断点 */\r\n            --wire-breakpoint: 768px;\r\n        }\r\n\r\n        /* ===== 主题应用 ===== */\r\n        @media (prefers-color-scheme: light) {\r\n            body {\r\n                --color-bg-default: var(--light-color-bg-default);\r\n                --color-text-primary: var(--light-color-text-primary);\r\n                --color-text-secondary: var(--light-color-text-secondary);\r\n                --pause-background-color: var(--light-pause-background-color);\r\n                --ring-stroke-color: #006ED356;\r\n                --ring-fill-color: #0084ff0A;\r\n                --wire-pc-depth-zero-color: #006ED356;\r\n            }\r\n        }\r\n        @media (prefers-color-scheme: dark) {\r\n            body {\r\n                --color-bg-default: var(--dark-color-bg-default);\r\n                --color-text-primary: var(--dark-color-text-primary);\r\n                --color-text-secondary: var(--dark-color-text-secondary);\r\n                --pause-background-color: var(--dark-pause-background-color);\r\n                --ring-stroke-color: #95c0e580;\r\n                --ring-fill-color: #95c0e50A;\r\n                --wire-pc-depth-zero-color: #95c0e580;\r\n            }\r\n        }\r\n\r\n        /* ===== 全局重置 ===== */\r\n        *,\r\n        *::before,\r\n        *::after {\r\n            box-sizing: border-box;\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        html {\r\n            font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\r\n            -webkit-text-size-adjust: 100%;\r\n        }\r\n\r\n        body {\r\n            min-height: 100vh;\r\n            background-color: var(--color-bg-default);\r\n            overflow-x: hidden;\r\n            transition: background-color 0.3s ease;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        /* ===== 背景层 ===== */\r\n        .background-layer {\r\n            position: fixed;\r\n            inset: 0;\r\n            z-index: 0;\r\n            background-color: var(--color-bg-default);\r\n            pointer-events: none;\r\n            overflow: visible;\r\n            transition: background-color 0.3s ease;\r\n        }\r\n\r\n        /* ===== 线框容器 ===== */\r\n        .wire-layer {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            overflow: hidden;\r\n            pointer-events: none;\r\n            z-index: 1;\r\n        }\r\n\r\n        /* ===== 单个线框 SVG ===== */\r\n        .depth-wire-frame {\r\n            position: absolute;\r\n            overflow: visible;\r\n            pointer-events: none;\r\n        }\r\n        .depth-wire-frame .st0 {\r\n            fill: none;\r\n            stroke: var(--wire-pc-depth-zero-color);\r\n            stroke-width: var(--wire-pc-depth-zero-line-width);\r\n            stroke-linecap: round;\r\n            stroke-linejoin: round;\r\n        }\r\n\r\n        /* ===== 线框位置 & 深度样式 ===== */\r\n        /* 深度 0 — 最大最亮 */\r\n        .wire-d0 {\r\n            width: 50vw;\r\n            height: 50vw;\r\n            left: -5vw;\r\n            top: 10vh;\r\n            filter: brightness(100%);\r\n            z-index: 100;\r\n            opacity: 0.9;\r\n        }\r\n        /* 深度 2 */\r\n        .wire-d2 {\r\n            width: 40.3vw;\r\n            height: 40.3vw;\r\n            left: 59.85vw;\r\n            top: 5vh;\r\n            filter: brightness(88%);\r\n            z-index: 98;\r\n            opacity: 0.85;\r\n        }\r\n        /* 深度 5 */\r\n        .wire-d5 {\r\n            width: 31.25vw;\r\n            height: 31.25vw;\r\n            left: 34.375vw;\r\n            top: 42vh;\r\n            filter: brightness(70%);\r\n            z-index: 95;\r\n            opacity: 0.75;\r\n        }\r\n        /* 深度 3 */\r\n        .wire-d3 {\r\n            width: 36.75vw;\r\n            height: 36.75vw;\r\n            left: 71.625vw;\r\n            top: 62vh;\r\n            filter: brightness(82%);\r\n            z-index: 97;\r\n            opacity: 0.80;\r\n        }\r\n        /* 深度 7 */\r\n        .wire-d7 {\r\n            width: 27.15vw;\r\n            height: 27.15vw;\r\n            left: 1.425vw;\r\n            top: 55vh;\r\n            filter: brightness(58%);\r\n            z-index: 93;\r\n            opacity: 0.65;\r\n        }\r\n        /* 深度 10 */\r\n        .wire-d10 {\r\n            width: 22.75vw;\r\n            height: 22.75vw;\r\n            left: 28.625vw;\r\n            top: 78vh;\r\n            filter: brightness(40%);\r\n            z-index: 90;\r\n            opacity: 0.50;\r\n        }\r\n        /* 深度 4 — 额外一个，丰富层次 */\r\n        .wire-d4 {\r\n            width: 33.6vw;\r\n            height: 33.6vw;\r\n            left: 52vw;\r\n            top: 25vh;\r\n            filter: brightness(76%);\r\n            z-index: 96;\r\n            opacity: 0.78;\r\n        }\r\n\r\n        /* ===== 环形遮罩（模糊） ===== */\r\n        .ring-overlay {\r\n            position: fixed;\r\n            inset: 0;\r\n            display: block;\r\n            pointer-events: none;\r\n            z-index: 2;\r\n            -webkit-backdrop-filter: blur(var(--ring-blur));\r\n            backdrop-filter: blur(var(--ring-blur));\r\n            -webkit-mask: url(#ring-mask);\r\n            mask: url(#ring-mask);\r\n            -webkit-mask-repeat: no-repeat;\r\n            mask-repeat: no-repeat;\r\n        }\r\n\r\n        /* ===== 环形描边 ===== */\r\n        .ring-stroke {\r\n            position: fixed;\r\n            inset: 0;\r\n            pointer-events: none;\r\n            z-index: 3;\r\n        }\r\n        .ring-stroke svg {\r\n            position: absolute;\r\n            overflow: visible;\r\n            pointer-events: none;\r\n            width: 100%;\r\n            height: 100%;\r\n        }\r\n        .ring-stroke svg circle {\r\n            fill: var(--ring-fill-color);\r\n            transition: fill 0.3s ease;\r\n        }\r\n        .ring-stroke svg .decoration-line {\r\n            opacity: 1;\r\n            transition: opacity 0.3s ease;\r\n        }\r\n\r\n        /* ===== 页面内容（仅用于展示） ===== */\r\n        .content {\r\n            position: relative;\r\n            z-index: 5;\r\n            padding: 2rem;\r\n            max-width: 720px;\r\n            margin: 0 auto;\r\n            text-align: center;\r\n            color: var(--color-text-primary);\r\n            transition: color 0.3s ease;\r\n            pointer-events: auto;\r\n            min-height: 100vh;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n        .content h1 {\r\n            font-size: clamp(2rem, 6vw, 3.6rem);\r\n            font-weight: 300;\r\n            letter-spacing: 0.06em;\r\n            margin-bottom: 0.5rem;\r\n            color: var(--color-text-primary);\r\n            -webkit-text-stroke: 2px var(--color-text-secondary);\r\n            -webkit-text-stroke-color: var(--color-text-secondary);\r\n            -webkit-text-fill-color: transparent;\r\n            text-shadow: none;\r\n        }\r\n        .content p {\r\n            font-size: 1rem;\r\n            opacity: 0.7;\r\n            margin-top: 0.25rem;\r\n            color: var(--color-text-secondary);\r\n        }\r\n        .content .badge {\r\n            display: inline-block;\r\n            margin-top: 1.5rem;\r\n            padding: 0.4rem 1.2rem;\r\n            border: 1px solid var(--color-border);\r\n            border-radius: 40px;\r\n            font-size: 0.75rem;\r\n            letter-spacing: 0.04em;\r\n            color: var(--color-text-secondary);\r\n            background: var(--ring-fill-color);\r\n            backdrop-filter: blur(4px);\r\n            -webkit-backdrop-filter: blur(4px);\r\n        }\r\n\r\n        /* ===== 响应式 ===== */\r\n        @media (max-width: 768px) {\r\n            .wire-d0 {\r\n                width: 70vw;\r\n                height: 70vw;\r\n                left: -10vw;\r\n                top: 5vh;\r\n            }\r\n            .wire-d2 {\r\n                width: 56vw;\r\n                height: 56vw;\r\n                left: 44vw;\r\n                top: 2vh;\r\n            }\r\n            .wire-d5 {\r\n                width: 44vw;\r\n                height: 44vw;\r\n                left: 28vw;\r\n                top: 38vh;\r\n            }\r\n            .wire-d3 {\r\n                width: 50vw;\r\n                height: 50vw;\r\n                left: 55vw;\r\n                top: 55vh;\r\n            }\r\n            .wire-d7 {\r\n                width: 38vw;\r\n                height: 38vw;\r\n                left: 2vw;\r\n                top: 48vh;\r\n            }\r\n            .wire-d10 {\r\n                width: 32vw;\r\n                height: 32vw;\r\n                left: 20vw;\r\n                top: 70vh;\r\n            }\r\n            .wire-d4 {\r\n                width: 46vw;\r\n                height: 46vw;\r\n                left: 40vw;\r\n                top: 20vh;\r\n            }\r\n            .content h1 {\r\n                font-size: clamp(1.6rem, 8vw, 2.6rem);\r\n            }\r\n        }\r\n        @media (max-width: 480px) {\r\n            .wire-d0 {\r\n                width: 90vw;\r\n                height: 90vw;\r\n                left: -15vw;\r\n                top: 2vh;\r\n            }\r\n            .wire-d2 {\r\n                width: 72vw;\r\n                height: 72vw;\r\n                left: 36vw;\r\n                top: 0vh;\r\n            }\r\n            .wire-d5 {\r\n                width: 56vw;\r\n                height: 56vw;\r\n                left: 22vw;\r\n                top: 32vh;\r\n            }\r\n            .wire-d3 {\r\n                width: 64vw;\r\n                height: 64vw;\r\n                left: 44vw;\r\n                top: 48vh;\r\n            }\r\n            .wire-d7 {\r\n                width: 48vw;\r\n                height: 48vw;\r\n                left: 0vw;\r\n                top: 42vh;\r\n            }\r\n            .wire-d10 {\r\n                width: 40vw;\r\n                height: 40vw;\r\n                left: 14vw;\r\n                top: 62vh;\r\n            }\r\n            .wire-d4 {\r\n                width: 58vw;\r\n                height: 58vw;\r\n                left: 32vw;\r\n                top: 16vh;\r\n            }\r\n        }\r\n\r\n        /* ===== 页脚 ===== */\r\n        .footer {\r\n            position: relative;\r\n            z-index: 5;\r\n            padding: 1.5rem 1rem 1rem;\r\n            text-align: center;\r\n            font-size: 0.6rem;\r\n            color: var(--color-text-secondary);\r\n            opacity: 0.4;\r\n            pointer-events: auto;\r\n            margin-top: auto;\r\n        }\r\n        .footer a {\r\n            color: inherit;\r\n            text-decoration: none;\r\n            border-bottom: 1px dotted currentColor;\r\n        }\r\n        .footer a:hover {\r\n            opacity: 0.8;\r\n        }\r\n\r\n        /* ===== 工具类 ===== */\r\n        .sr-only {\r\n            position: absolute;\r\n            width: 1px;\r\n            height: 1px;\r\n            padding: 0;\r\n            margin: -1px;\r\n            overflow: hidden;\r\n            clip: rect(0, 0, 0, 0);\r\n            border: 0;\r\n        }\r\n\r\n        /* 遮罩 SVG 定义（内联） */\r\n        .mask-defs {\r\n            position: absolute;\r\n            width: 0;\r\n            height: 0;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <!-- ===== 背景层 ===== -->\r\n    <div class=\"background-layer\" aria-hidden=\"true\">\r\n\r\n        <!-- ===== 线框层 ===== -->\r\n        <div class=\"wire-layer\">\r\n\r\n            <!-- 线框 1 · 深度 0 -->\r\n            <svg class=\"depth-wire-frame wire-d0\" viewBox=\"0 0 875 875\">\r\n                <rect class=\"st0\" x=\"0\" y=\"0\" width=\"875\" height=\"875\" />\r\n                <line class=\"st0\" x1=\"0\" y1=\"175\" x2=\"875\" y2=\"175\" />\r\n                <line class=\"st0\" x1=\"0\" y1=\"350\" x2=\"875\" y2=\"350\" />\r\n             